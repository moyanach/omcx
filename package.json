{
  "name": "omcx-desktop",
  "version": "2.0.0",
  "description": "OMCX - Professional AI Coding Agent Desktop Client",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pack": "vite build && electron-builder --mac",
    "start": "electron ."
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "cheerio": "^1.2.0",
    "langchain": "^1.4.4",
    "lucide-react": "^0.344.0",
    "marked": "^18.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.omcx.desktop",
    "productName": "OMCX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "services/**/*",
      "utils/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
