{
  "name": "omcx-desktop",
  "version": "2.1.10",
  "description": "OMCX - Professional AI Coding Agent Desktop Client",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pack": "vite build && electron-builder --mac",
    "start": "electron .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper node_modules/node-pty/prebuilds/darwin-x64/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "^2.3.5",
    "better-sqlite3": "^9.6.0",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "katex": "^0.19.1",
    "langchain": "^1.4.4",
    "lucide-react": "^0.344.0",
    "marked": "^18.0.5",
    "mermaid": "^12.3.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.0.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.omcx.desktop",
    "productName": "OMCX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "services/**/*",
      "utils/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "moyanach",
        "repo": "omcx"
      }
    ]
  }
}
