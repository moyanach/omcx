{
  "name": "omcx-desktop",
  "version": "2.1.11",
  "description": "OMCX - Professional AI Coding Agent Desktop Client",
  "main": "main.js",
  "bin": {
    "omcx-cli": "./bin/omcx-cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "cli": "node bin/omcx-cli.js",
    "bundle:headless": "node scripts/build-headless-bundle.js",
    "pack": "npm run build && electron-builder --mac",
    "start": "electron .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper node_modules/node-pty/prebuilds/darwin-x64/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.0.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "^2.3.5",
    "autoprefixer": "^10.4.18",
    "diff": "^9.0.0",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "katex": "^0.19.1",
    "lucide-react": "^0.344.0",
    "mermaid": "^12.3.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.omcx.desktop",
    "productName": "OMCX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "main/**/*",
      "preload.js",
      "services/**/*",
      "utils/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "moyanach",
        "repo": "omcx"
      }
    ]
  }
}
